---
/** no props: we will inject the HTML at runtime */
---

<div id="work-popup" class="work-popup">
  <div class="work-popup-content">
    <button id="close-popup" class="close-button">&times;</button>
    <!-- we will dynamically inject the detail here -->
    <div class="popup-inner-content"></div>
  </div>
</div>

<style>
  .work-popup {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .work-popup.open {
    opacity: 1;
    visibility: visible;
  }

  .work-popup-content {
    background-color: var(--theme-bg);
    padding: 2rem;
    border-radius: 0.5rem;
    max-width: 800px;
    max-height: 80vh;
    width: 90%;
    overflow-y: auto;
    position: relative;
    box-shadow: var(--shadow-lg);
  }

  .close-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 2rem;
    color: var(--gray-300);
    cursor: pointer;
  }

  /* Styles for content loaded into the popup */
  .popup-inner-content .title {
    font-size: var(--text-3xl);
    color: var(--gray-100);
  }

  .popup-inner-content .tagline {
    font-size: var(--text-lg);
    color: var(--gray-300);
  }

  .popup-inner-content .hero-image {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .popup-inner-content .content {
    color: var(--gray-200);
    line-height: 1.6;
  }

  .popup-inner-content .content > :global(* + *) {
    margin-top: 1rem;
  }

  .popup-inner-content .content :global(h2),
  .popup-inner-content .content :global(h3),
  .popup-inner-content .content :global(h4) {
    color: var(--gray-100);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .popup-inner-content .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 1rem 0;
  }

  .popup-inner-content .tag {
    background: var(--accent-regular);
    color: var(--accent-text-over);
    padding: 0.25rem 0.75rem;
    border-radius: 999rem;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .go-to-work-btn {
    display: inline-block;
    background: var(--accent-regular);
    color: var(--accent-text-over);
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }

  .go-to-work-btn:hover {
    background: var(--accent-dark);
  }

  /* Responsive sizing */
  @media (min-width: 768px) {
    .work-popup-content {
      width: 80%;
      max-width: 900px;
    }
  }

  @media (min-width: 1024px) {
    .work-popup-content {
      width: 70%;
      max-width: 1000px;
    }
  }

  /* Better spacing for popup content */
  .popup-inner-content .popup-detail {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .popup-inner-content .hero-image {
    max-height: 400px;
    object-fit: cover;
  }
</style>