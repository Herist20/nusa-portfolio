---
import { getCollection, render } from 'astro:content';

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from '../layouts/BaseLayout.astro';

// Component Imports
import CallToAction from '../components/CallToAction.astro';
import Grid from '../components/Grid.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';

import WorkPopup from '../components/WorkPopup.astro';

// Page section components
import ContactCTA from '../components/ContactCTA.astro';
import Skills from '../components/Skills.astro';
import Image from '../components/Image.astro';
import portrait from '../assets/portrait.jpg';


// Content Fetching: List four most recent work projects
const entries = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 4);

// Pre-render each MD body to a <Content> component
// and compute a slug‐safe "sanitizedId" for the template.
const projects = await Promise.all(
	entries.map(async (entry) => {
		// render() is the .md → Astro component step
		const { Content } = await render(entry);
		return {
			id: entry.id,                            // e.g. "nested/duvet-genius"
			sanitizedId: entry.id.replace(/\//g, '-'), // e.g. "nested-duvet-genius"
			entry: entry,
			title: entry.data.title,
			tagline: entry.data.description,
			tags: entry.data.tags,
			img: entry.data.img,
			img_alt: entry.data.img_alt,
			Content,
		};
	})
);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">
		<div class="wrapper stack gap-8 lg:gap-20">
			<header class="hero">
				<Hero
					title="Hello, my name is Putra"
					tagline="I am a passionate developer creating web applications."
					align="start"
				>
					<div class="roles">
						<Pill><Icon icon="code" size="1.33em" /> Developer</Pill>
						<Pill><Icon icon="microphone-stage" size="1.33em" /> Speaker</Pill>
						<Pill><Icon icon="pencil-line" size="1.33em" /> Writer</Pill>
					</div>
				</Hero>

				<Image 
					src={portrait}
					alt="A placeholder Pic"
					width={480}
					height={620}
				/>
			</header>

			<Skills />
		</div>

		<main class="wrapper stack gap-20 lg:gap-48">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>Selected Work</h3>
					<p>Take a look below at some of my featured work for clients from the past few years.</p>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							projects.map((proj) => (
								<li>
									<PortfolioPreview project={proj.entry} popup />
								</li>
							))
						}
					</Grid>
				</div>

				<div class="cta">
					<CallToAction href="/work/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>

			
		</main>

		<ContactCTA />
	</div>

	<!-- HIDDEN TEMPLATES with full content and our Go-to-page link -->
	{
		projects.map((proj) => (
			<template id={`tmpl-${proj.sanitizedId}`}>
				<div class="popup-detail">
					<h2 class="title">{proj.title}</h2>
					<img
						class="hero-image"
						src={proj.img.src}
						alt={proj.img_alt}
						width={proj.img.width}
						height={proj.img.height}
					/>
					<p class="tagline">{proj.tagline}</p>
					<div class="tags">
						{proj.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
					<div class="content">
						<proj.Content />
					</div>
					<div style="margin-top:1.5rem;text-align:center;">
						<a class="go-to-work-btn" href={`/work/${proj.id}`}>
							Go to Work Page →
						</a>
					</div>
				</div>
			</template>
		))
	}

	<!-- INSERT THE POPUP MARKUP -->
	<WorkPopup />

	<!-- INLINE SCRIPT to wire up open/close & content‐cloning -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			const popup = document.getElementById('work-popup');
			const inner = popup.querySelector('.popup-inner-content');

			// open on any .card[data-id]
			document.querySelectorAll('.card[data-id]').forEach((card) => {
				card.addEventListener('click', (e) => {
					e.preventDefault();
					const id = card.getAttribute('data-id');
					const safeId = id.replace(/\//g, '-');
					const tmpl = document.getElementById(`tmpl-${safeId}`);
					if (!tmpl) return;
					// clear old
					inner.innerHTML = '';
					// clone fresh
					inner.appendChild(tmpl.content.cloneNode(true));
					popup.classList.add('open');
				});
			});

			// close button
			popup.querySelector('#close-popup')
				.addEventListener('click', () => popup.classList.remove('open'));

			// clicking the overlay (outside content) closes
			popup.addEventListener('click', (e) => {
				if (e.target.id === 'work-popup') {
					popup.classList.remove('open');
				}
			});

			// ESC key closes
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && popup.classList.contains('open')) {
					popup.classList.remove('open');
				}
			});
		});
	</script>
</BaseLayout>



<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.roles {
		display: none;
	}

	.hero img {
		aspect-ratio: 5 / 4;
		object-fit: cover;
		object-position: top;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.roles {
			margin-top: 0.5rem;
			display: flex;
			gap: 0.5rem;
		}

		.hero img {
			aspect-ratio: 3 / 4;
			border-radius: 4.5rem;
			object-fit: cover;
		}
	}

	/* ====================================================== */

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.with-background.bg-variant::before {
		--hero-bg: var(--bg-image-subtle-1);
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}

		.cta {
			grid-area: cta;
		}
	}

	/* ====================================================== */

	.mention-card {
		display: flex;
		height: 7rem;
		justify-content: center;
		align-items: center;
		text-align: center;
		border: 1px solid var(--gray-800);
		border-radius: 1.5rem;
		color: var(--gray-300);
		background: var(--gradient-subtle);
		box-shadow: var(--shadow-sm);
	}

	@media (min-width: 50em) {
		.mention-card {
			border-radius: 1.5rem;
			height: 9.5rem;
		}
	}
</style>
